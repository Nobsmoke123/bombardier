# Database (Neon in production, local Postgres via docker-compose)
DATABASE_URL="postgresql://jobtracker:jobtracker@localhost:5432/jobtracker"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Cookie (set COOKIE_SECURE=true in production)
COOKIE_SECURE="false"

# API
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Redis (used by later milestones)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Cloudflare R2 (presigned uploads; API never receives file bytes)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
