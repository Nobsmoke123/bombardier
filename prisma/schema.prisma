generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String   @unique
  password    String
  dailyTarget Int      @default(20)
  createdAt   DateTime @default(now())
  resumes     Resume[]
  companies   Company[]
  csvImports  CsvImport[]
}

enum ResumeFocus {
  BACKEND
  FULLSTACK
  FRONTEND
  DEVOPS
}

model Resume {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  focus     ResumeFocus
  fileKey   String      @unique
  createdAt     DateTime      @default(now())
  applications  Application[]

  @@index([userId])
}

model Company {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  website        String?
  industry       String?
  createdAt      DateTime     @default(now())
  application    Application?

  @@unique([userId, normalizedName])
  @@index([userId])
}

enum ApplicationStatus {
  NOT_APPLIED
  APPLIED
  HR_STAGE
  TECHNICAL
  FINAL_INTERVIEW
  ACCEPTED
  REJECTED
}

model Application {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @unique @db.Uuid
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resumeId         String?           @db.Uuid
  resume           Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  role             String            @default("")
  coverLetter      String?
  linkedinMessage  String?
  applied          Boolean           @default(false)
  linkedinOutreach Boolean           @default(false)
  connectionCount  Int               @default(0)
  applicationDate  DateTime?
  status           ApplicationStatus @default(NOT_APPLIED)

  @@index([status])
  @@index([resumeId])
}

enum CsvImportStatus {
  PENDING
  COMPLETED
  FAILED
}

model CsvImport {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @db.Uuid
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename           String
  objectKey          String
  totalRows          Int             @default(0)
  uniqueRows         Int             @default(0)
  duplicatesRemoved  Int             @default(0)
  status             CsvImportStatus @default(PENDING)
  error              String?
  createdAt          DateTime        @default(now())

  @@index([userId])
}
